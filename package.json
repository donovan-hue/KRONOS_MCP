{
  "name": "kronos-mcp",
  "version": "0.3.0",
  "description": "KRONOS MCP server with connected KRONOS tools and 180 local deterministic tools over stdio and Streamable HTTP",
  "license": "ISC",
  "homepage": "https://github.com/donovan-hue/KRONOS_MCP#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donovan-hue/KRONOS_MCP.git"
  },
  "bugs": {
    "url": "https://github.com/donovan-hue/KRONOS_MCP/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "kronos",
    "ai-tools",
    "stdio",
    "streamable-http"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "kronos-mcp": "dist/index.js",
    "kronos-mcp-http": "dist/http.js"
  },
  "files": [
    "dist",
    "docs/HERRAMIENTAS_180.md",
    "docs/KRONOS_MCP_180_Herramientas.txt"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "npm run build && node --import tsx --test tests/*.test.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:http": "node dist/http.js",
    "dev": "tsx src/index.ts",
    "dev:http": "tsx src/http.ts",
    "generate:catalog": "node scripts/generate-catalog.mjs",
    "verify:mcp": "node scripts/verify-mcp.mjs",
    "verify:tarball": "node scripts/verify-npm-tarball.mjs",
    "diagnose:kronos": "node scripts/diagnose-kronos.mjs",
    "pack:check": "npm pack --dry-run",
    "prepack": "npm run build",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^18.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
