# Optional environment. Use development, test or production.
NODE_ENV=development

# KRONOS API base URL (HTTPS required).
KRONOS_API_URL=https://api.kronos-space.com

# Service credential for /api/mcp/me. Keep the secret in an ignored local env file.
KRONOS_MCP_TOKEN=

# HTTP deployment profile:
# - authenticated: full 184-tool server behind MSP_HTTP_BEARER_TOKEN.
# - public-local: anonymous 163 stateless local tools for ChatGPT No Auth.
MSP_HTTP_PROFILE=authenticated

# Required only for MSP_HTTP_PROFILE=authenticated. Do not commit a real token.
# Generate a random secret of at least 32 characters and store it in hosting secrets.
MSP_HTTP_BEARER_TOKEN=
MSP_HTTP_PORT=3000
MSP_HTTP_HOST=0.0.0.0
MSP_HTTP_MAX_BODY_BYTES=2097152

# 0 disables the built-in fixed-window limiter. public-local defaults to 240.
MSP_HTTP_RATE_LIMIT_PER_MINUTE=

# Set true only behind a trusted HTTPS proxy that supplies X-Forwarded-For.
MSP_HTTP_TRUST_PROXY=false
