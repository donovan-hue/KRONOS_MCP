# Optional environment. Use development, test or production.
NODE_ENV=development

# KRONOS API base URL (HTTPS required).
KRONOS_API_URL=https://api.kronos-space.com

# Service credential for /api/mcp/me. Keep the secret in an ignored local env file.
KRONOS_MCP_TOKEN=

# Optional public MCP HTTP transport. Do not commit a real token.
# Generate a random secret of at least 32 characters and store it in hosting secrets.
MSP_HTTP_BEARER_TOKEN=
MSP_HTTP_PORT=3000
MSP_HTTP_HOST=0.0.0.0
